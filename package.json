    "./ui/panelExtensions": "./src/ui/panelExtensions.ts",
    "./util/gmFetch": "./src/util/gmFetch.ts",
    "./util/prefs": "./src/util/prefs.ts",
    "./util/reliableTimers": "./src/util/reliableTimers.ts",
    "./version": "./src/version.ts",
    "./ws/api": "./src/ws/api.ts",
    "./package.json": "./package.json",
    "./boot/luminus": "./src/boot/bootLuminus.ts"
  },
  "types": "./src/boot/bootLuminus.ts",
  "scripts": {
    "dev": "vite build --mode main-dev --watch",
    "dev:main": "vite build --mode main-dev --watch",
    "clean:dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean:dist && npm run build:main && npm run build:main-dev",
    "build:main": "vite build --mode main",
    "build:main-dev": "vite build --mode main-dev",
    "typecheck": "tsc --noEmit",
    "release": "npm run typecheck && npm run clean:dist && npm run build:main",
    "release:full": "npm run typecheck && npm run clean:dist && npm run build:main && npm run build:main-dev",
    "test:furniture-floor": "node --experimental-strip-types src/messages/incoming/FurnitureFloorParser.test.ts",
    "test:users-parser": "esbuild src/messages/incoming/UsersParser.test.ts --bundle --platform=node --format=esm | node --input-type=module",
    "test:reliable-timers": "node --experimental-strip-types src/util/reliableTimers.test.ts",
    "test:prefs": "node --experimental-strip-types src/util/prefs.test.ts",
    "test:catalog-thumbs": "node --experimental-strip-types src/ui/catalogThumbManifest.test.ts",
    "test:catalog-thumb-additive": "node --experimental-strip-types src/ui/catalogThumbAdditive.test.ts",
    "test:catalog-thumb-load-queue": "node --experimental-strip-types src/ui/catalogThumbLoadQueue.test.ts",
    "test:catalog-thumb-presentation": "node --experimental-strip-types src/ui/catalogThumbPresentation.test.ts",
    "test:panel-navigation": "esbuild src/ui/panelNavigation.test.ts --bundle --platform=node --format=esm | node --input-type=module",
    "test:enables-handitems": "esbuild src/ui/enablesHanditemsCatalog.test.ts --bundle --platform=node --format=esm | node --input-type=module",
    "test:ws-intercept": "esbuild src/ws/interceptWebSocket.test.ts --bundle --platform=node --format=esm | node --input-type=module",
    "test:room-enter": "node --experimental-strip-types src/room/roomStore.enter.test.ts"
  },
  "devDependencies": {
    "@radix-ui/react-separator": "1.1.11",
    "@radix-ui/react-slider": "1.4.3",
    "@radix-ui/react-switch": "1.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@shadcn/react": "0.2.1",
    "lucide-react": "1.24.0"
  }
}
