{
  "name": "luminus",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Userscript Luminus para o Habblet Hotel — painel, player, logs, visual e links.",
  "homepage": "https://github.com/iIlusion/luminus",
  "bugs": {
    "url": "https://github.com/iIlusion/luminus/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iIlusion/luminus.git"
  },
  "exports": {
    ".": "./src/boot/bootLuminus.ts",
    "./boot": "./src/boot/bootLuminus.ts",
    "./changelog": "./src/changelog.ts",
    "./messages/incoming/FurnitureFloorParser": "./src/messages/incoming/FurnitureFloorParser.ts",
    "./messages/incoming/FurnitureFloorAddParser": "./src/messages/incoming/FurnitureFloorAddParser.ts",
    "./messages/incoming/ObjectsDataUpdateParser": "./src/messages/incoming/ObjectsDataUpdateParser.ts",
    "./messages/incoming/RoomChatParser": "./src/messages/incoming/RoomChatParser.ts",
    "./messages/incoming/UserObjectParser": "./src/messages/incoming/UserObjectParser.ts",
    "./messages/incoming/UserUpdateParser": "./src/messages/incoming/UserUpdateParser.ts",
    "./messages/incoming/WiredMovementsParser": "./src/messages/incoming/WiredMovementsParser.ts",
    "./messages/incoming/RoomModelParser": "./src/messages/incoming/RoomModelParser.ts",
    "./messages/incoming/RoomEntryTileParser": "./src/messages/incoming/RoomEntryTileParser.ts",
    "./messages/incoming/RoomThicknessParser": "./src/messages/incoming/RoomThicknessParser.ts",
    "./messages/incoming/FurnitureInventoryParser": "./src/messages/incoming/FurnitureInventoryParser.ts",
    "./messages/incoming/ProductOfferParser": "./src/messages/incoming/ProductOfferParser.ts",
