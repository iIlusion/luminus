    "./messages/incoming/CatalogPurchaseOkParser": "./src/messages/incoming/CatalogPurchaseOkParser.ts",
    "./messages/incoming/CatalogPurchaseErrorParser": "./src/messages/incoming/CatalogPurchaseErrorParser.ts",
    "./messages/outgoing/GetCatalogPageComposer": "./src/messages/outgoing/GetCatalogPageComposer.ts",
    "./messages/incoming/WiredDefinitionParser": "./src/messages/incoming/WiredDefinitionParser.ts",
    "./messages/incoming/WiredVariablesParser": "./src/messages/incoming/WiredVariablesParser.ts",
    "./messages/incoming/WiredToolInspectionParser": "./src/messages/incoming/WiredToolInspectionParser.ts",
    "./messages/outgoing/RoomUnitChatComposer": "./src/messages/outgoing/RoomUnitChatComposer.ts",
    "./messages/outgoing/RoomEntryTileComposer": "./src/messages/outgoing/RoomEntryTileComposer.ts",
