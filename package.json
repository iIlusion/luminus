    "./messages/outgoing/RoomConstructionToolComposer": "./src/messages/outgoing/RoomConstructionToolComposer.ts",
    "./messages/outgoing/FurnitureInventoryComposer": "./src/messages/outgoing/FurnitureInventoryComposer.ts",
    "./messages/outgoing/ProductOfferComposer": "./src/messages/outgoing/ProductOfferComposer.ts",
    "./messages/outgoing/CatalogPurchaseComposer": "./src/messages/outgoing/CatalogPurchaseComposer.ts",
    "./messages/outgoing/RoomModelComposer": "./src/messages/outgoing/RoomModelComposer.ts",
    "./messages/outgoing/FurnitureMultiStateComposer": "./src/messages/outgoing/FurnitureMultiStateComposer.ts",
    "./messages/outgoing/WiredSaveComposers": "./src/messages/outgoing/WiredSaveComposers.ts",
    "./room/nitroWorldOverlay": "./src/room/nitroWorldOverlay.ts",
    "./room/furnitureData": "./src/room/furnitureData.ts",
